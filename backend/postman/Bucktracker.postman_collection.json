    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jwtTokenEnv = \"jwt_token\";\r",
                  "const refreshTokenEnv = \"refresh_token\";\r",
                  "const jwtToken = pm.response.json().access_token;\r",
                  "const refreshToken = pm.response.headers.get('Set-Cookie');\r",
                  "\r",
                  "// verify that we have a token value\r",
                  "pm.test(\"jwt token value should be present\", function() {\r",
                  "  pm.expect(jwtToken.length > 0);\r",
                  "});\r",
                  "pm.test(\"refresh token value should be present\", function() {\r",
